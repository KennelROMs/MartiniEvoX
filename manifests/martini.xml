<?xml version="1.0" encoding="UTF-8"?>
<!--
    Local manifest for OnePlus 9RT (martini, sm8350) on Evolution-X (branch cnb).

    Floating branches only. tools/refresh_lock.py merges this file with the
    current Evolution-X manifest and pins every project into
    manifests/locked/; builds always use the locked file.

    - LineageOS device/kernel trees and TheMuppets blobs (lineage-24.0)
    - PixelOS hardware/oplus fork and the OnePlus camera/Dolby components
      PixelOS ships (seventeen)
    - kernel/oneplus/sm8350-ksu: second checkout of the same kernel, patched
      only for KernelSU Next; external/KernelSU-Next is its legacy branch
-->
<manifest>
    <remote name="martini-los" fetch="https://github.com/LineageOS/" />
    <remote name="martini-vendor" fetch="https://github.com/TheMuppets/" />
    <remote name="martini-pixelos" fetch="https://github.com/PixelOS-AOSP/" />
    <remote name="martini-gitlab" fetch="https://gitlab.com/NoPrincessHere/" />
    <remote name="martini-ksu" fetch="https://github.com/KernelSU-Next/" />

    <project name="android_device_oneplus_martini" path="device/oneplus/martini"
             remote="martini-los" revision="lineage-24.0" />
    <project name="android_device_oneplus_sm8350-common" path="device/oneplus/sm8350-common"
             remote="martini-los" revision="lineage-24.0" />
    <project name="android_kernel_oneplus_sm8350" path="kernel/oneplus/sm8350"
             remote="martini-los" revision="lineage-24.0" />
    <project name="android_kernel_oneplus_sm8350" path="kernel/oneplus/sm8350-ksu"
             remote="martini-los" revision="lineage-24.0" />
    <project name="android_hardware_oplus" path="hardware/oplus"
             remote="martini-pixelos" revision="seventeen" />
    <project name="android_hardware_pixelworks_interfaces" path="hardware/pixelworks/interfaces"
             remote="martini-los" revision="lineage-24.0" />
    <project name="proprietary_vendor_oneplus_martini" path="vendor/oneplus/martini"
             remote="martini-vendor" revision="lineage-24.0" />
    <project name="proprietary_vendor_oneplus_sm8350-common" path="vendor/oneplus/sm8350-common"
             remote="martini-vendor" revision="lineage-24.0" />
    <project name="proprietary_vendor_oplus_camera" path="vendor/oplus/camera"
             remote="martini-gitlab" revision="seventeen" />
    <project name="proprietary_vendor_oneplus_dolby" path="vendor/oneplus/dolby"
             remote="martini-gitlab" revision="seventeen" />
    <project name="android_packages_apps_DolbyAtmos" path="packages/apps/DolbyAtmos"
             remote="martini-pixelos" revision="seventeen" />
    <project name="KernelSU-Next" path="external/KernelSU-Next"
             remote="martini-ksu" revision="legacy" />
</manifest>
