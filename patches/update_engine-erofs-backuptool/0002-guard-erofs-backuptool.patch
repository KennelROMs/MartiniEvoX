+bool ShouldRunBackuptool(const string& partition_name,
+                        const string& target_filesystem_type,
+                        const string& source_path) {
+  if (partition_name != "system" || target_filesystem_type != "ext4" ||
+      source_path.empty()) {
+    return false;
+  }
+
+  constexpr off64_t kSuperblockOffset = 0x400;
+  constexpr size_t kHeaderSize = 0x3a;
+  brillo::Blob header;
+  if (!ReadFileChunk(source_path, kSuperblockOffset, kHeaderSize, &header) ||
+      header.size() != kHeaderSize) {
+    LOG(WARNING) << "Skipping backuptool: cannot read filesystem header from "
+                 << source_path;
+    return false;
+  }
+
+  // EROFS stores other data where ext filesystems store the mount count/magic.
+  // Recognize it first, even if those unrelated bytes resemble ext metadata.
+  const bool is_erofs = header[0] == 0xe2 && header[1] == 0xe1 &&
+                        header[2] == 0xf5 && header[3] == 0xe0;
+  if (is_erofs || header[0x38] != 0x53 || header[0x39] != 0xef) {
+    LOG(INFO) << "Skipping backuptool: source is not an ext filesystem: "
+              << source_path;
+    return false;
+  }
+
+  const uint16_t mount_count = static_cast<uint16_t>(header[0x34]) |
+                              (static_cast<uint16_t>(header[0x35]) << 8);
+  LOG(INFO) << source_path << " ext mount count since fsck: " << mount_count;
+  return mount_count > 0;
+}
