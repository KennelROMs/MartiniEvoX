+namespace chromeos_update_engine {
+
+class BackuptoolEligibilityTest : public ::testing::Test {
+ protected:
+  brillo::Blob Header(uint16_t count, bool ext_magic, bool erofs_magic) {
+    brillo::Blob data(0x400 + 0x3a, 0);
+    data[0x434] = static_cast<uint8_t>(count & 0xff);
+    data[0x435] = static_cast<uint8_t>(count >> 8);
+    if (ext_magic) {
+      data[0x438] = 0x53;
+      data[0x439] = 0xef;
+    }
+    if (erofs_magic) {
+      data[0x400] = 0xe2;
+      data[0x401] = 0xe1;
+      data[0x402] = 0xf5;
+      data[0x403] = 0xe0;
+    }
+    return data;
+  }
+
+  ScopedTempFile source_{"backuptool_source.XXXXXX"};
+};
+
+TEST_F(BackuptoolEligibilityTest, FilesystemMatrix) {
+  struct Case {
+    const char* name;
+    const char* partition;
+    const char* target;
+    bool ext_magic;
+    bool erofs_magic;
+    uint16_t count;
+    bool expected;
+  };
+  const Case cases[] = {
+      {"ext-zero", "system", "ext4", true, false, 0, false},
+      {"ext-one", "system", "ext4", true, false, 1, true},
+      {"ext-high-byte", "system", "ext4", true, false, 0x0100, true},
+      {"ext-to-erofs", "system", "erofs", true, false, 1, false},
+      {"erofs-to-erofs", "system", "erofs", false, true, 1, false},
+      {"erofs-to-ext", "system", "ext4", false, true, 1, false},
+      {"erofs-magic-collision", "system", "ext4", true, true, 1, false},
+      {"unknown-source", "system", "ext4", false, false, 1, false},
+      {"non-system", "vendor", "ext4", true, false, 1, false},
+      {"unknown-target", "system", "", true, false, 1, false},
+  };
+  for (const auto& test : cases) {
+    SCOPED_TRACE(test.name);
+    const auto data = Header(test.count, test.ext_magic, test.erofs_magic);
+    ASSERT_TRUE(utils::WriteFile(source_.path().c_str(), data.data(), data.size()));
+    EXPECT_EQ(utils::ShouldRunBackuptool(
+                  test.partition, test.target, source_.path()),
+              test.expected);
+  }
+}
+
+TEST_F(BackuptoolEligibilityTest, EmptySourcePath) {
+  EXPECT_FALSE(utils::ShouldRunBackuptool("system", "ext4", ""));
+}
+
+TEST_F(BackuptoolEligibilityTest, MissingSourceFile) {
+  const std::string source_path = source_.path() + ".missing";
+  EXPECT_EXIT(
+      {
+        const bool run = utils::ShouldRunBackuptool("system", "ext4", source_path);
+        std::_Exit(run ? 1 : 0);
+      },
+      ::testing::ExitedWithCode(0),
+      ".*");
+}
+
+TEST_F(BackuptoolEligibilityTest, ShortSourceFiles) {
+  for (const size_t size : std::array<size_t, 4>{0, 0x400, 0x435, 0x439}) {
+    SCOPED_TRACE(size);
+    auto data = Header(1, true, false);
+    data.resize(size);
+    ASSERT_TRUE(utils::WriteFile(source_.path().c_str(), data.data(), data.size()));
+    const std::string source_path = source_.path();
+    EXPECT_EXIT(
+        {
+          const bool run = utils::ShouldRunBackuptool("system", "ext4", source_path);
+          std::_Exit(run ? 1 : 0);
+        },
+        ::testing::ExitedWithCode(0),
+        ".*");
+  }
+}
